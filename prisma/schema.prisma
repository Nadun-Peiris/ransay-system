generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderType {
  VAT
  NON_VAT
}

enum CreatedByRole {
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  DELETED
}

enum PaymentType {
  PAID_NOW
  CREDIT
}

enum PaymentStatus {
  PENDING
  DUE
  OVERDUE
  PAID
}

enum FulfillmentStatus {
  UNFULFILLED
  FULFILLED
}

enum DeliveryStatus {
  NOT_DISPATCHED
  DISPATCHED
  DELIVERED
}

enum IdSequenceKey {
  ORDER
  VAT_ORDER
  NON_VAT_ORDER
  IMPORT
}

enum StockMovementType {
  ORDER_SALE
  ORDER_COMMIT
  ORDER_UNCOMMIT
  ORDER_DELIVERY_DEDUCTION
  ORDER_DELETE_REVERSAL
  STOCK_IN
  STOCK_OUT
  STOCK_ADJUSTMENT
  IMPORT_IN
  ORDER_DELIVERED
  ORDER_CANCEL_RESTORE
  IMPORT_REVERSE
  MANUAL_ADJUSTMENT
}

enum ImportStatus {
  DRAFT
  CONFIRMED
  CANCELLED
  REVERSED
}

enum StockBatchStatus {
  ACTIVE
  DEPLETED
  REVERSED
}

enum ExpenseCategory {
  TRANSPORT
  SALARY
  RENT
  ELECTRICITY
  FUEL
  PACKAGING
  OFFICE
  MAINTENANCE
  MARKETING
  OTHER
}

enum ExpensePaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHEQUE
  OTHER
}

enum ExpenseStatus {
  ACTIVE
  DELETED
}

model User {
  id String @id @default(uuid()) @db.Uuid

  name         String
  email        String? @unique
  passwordHash String? @map("password_hash")

  role     CreatedByRole @default(ADMIN)
  isActive Boolean       @default(true) @map("is_active")

  createdOrders Order[] @relation("OrdersCreatedByUser")
  deletedOrders Order[] @relation("OrdersDeletedByUser")

  stockMovements StockMovement[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Customer {
  id String @id @default(uuid()) @db.Uuid

  customerCode String? @unique @map("customer_code")
  customerName String @map("customer_name")
  contactPerson String? @map("contact_person")
  phone        String?
  email        String?
  address      String?
  position     String?

  customerType OrderType @map("customer_type")
  vatNumber    String?   @map("vat_number")

  isActive Boolean @default(true) @map("is_active")

  addresses CustomerAddress[]
  orders    Order[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerCode])
  @@index([customerName])
  @@index([customerType])
  @@map("customers")
}

model CustomerAddress {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  label     String?
  address   String
  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([customerId])
  @@map("customer_addresses")
}

model Product {
  id String @id @default(uuid()) @db.Uuid

  productName String  @map("product_name")
  sku         String? @unique

  kgPerBag Decimal @map("kg_per_bag") @db.Decimal(10, 2)

  stockBags Decimal @default(0) @map("stock_bags") @db.Decimal(12, 2)
  stockKg   Decimal @default(0) @map("stock_kg") @db.Decimal(12, 2)

  committedBags Decimal @default(0) @map("committed_bags") @db.Decimal(12, 2)
  committedKg   Decimal @default(0) @map("committed_kg") @db.Decimal(12, 2)

  unavailableBags Decimal @default(0) @map("unavailable_bags") @db.Decimal(12, 2)
  unavailableKg   Decimal @default(0) @map("unavailable_kg") @db.Decimal(12, 2)

  defaultSellingPricePerKg Decimal @default(0) @map("default_selling_price_per_kg") @db.Decimal(12, 2)

  isActive Boolean @default(true) @map("is_active")

  orderItems     OrderItem[]
  stockMovements StockMovement[]
  importItems    ImportItem[]
  stockBatches   StockBatch[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([productName])
  @@index([sku])
  @@index([committedBags])
  @@index([unavailableBags])
  @@map("products")
}

model Order {
  id String @id @default(uuid()) @db.Uuid

  orderId       String  @unique @map("order_id")
  vatOrderId    String? @unique @map("vat_order_id")
  nonVatOrderId String? @unique @map("non_vat_order_id")

  createdByRole   CreatedByRole @map("created_by_role")
  createdByUserId String        @map("created_by_user_id") @db.Uuid
  createdByUser   User          @relation("OrdersCreatedByUser", fields: [createdByUserId], references: [id], onDelete: Restrict)

  customerId String   @map("customer_id") @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  customerName              String    @map("customer_name")
  customerContactPerson     String?   @map("customer_contact_person")
  customerPhone             String?   @map("customer_phone")
  customerAddress           String?   @map("customer_address")
  customerTypeSnapshot      OrderType @map("customer_type_snapshot")
  customerVatNumberSnapshot String?   @map("customer_vat_number_snapshot")

  orderType OrderType @map("order_type")

  isSelected Boolean @default(false) @map("is_selected")

  subtotal       Decimal @default(0) @map("subtotal") @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  deliveryAmount Decimal @default(0) @map("delivery_amount") @db.Decimal(12, 2)
  vatRate        Decimal @default(0) @map("vat_rate") @db.Decimal(5, 2)
  vatAmount      Decimal @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @map("total_amount") @db.Decimal(12, 2)

  orderStatus       OrderStatus       @default(ACTIVE) @map("order_status")
  paymentType       PaymentType       @map("payment_type")
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  deliveryStatus    DeliveryStatus    @default(NOT_DISPATCHED) @map("delivery_status")

  paymentDueDate DateTime? @map("payment_due_date") @db.Date
  paidAt         DateTime? @map("paid_at") @db.Timestamptz(6)

  notes String?

  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid
  deletedByUser   User?     @relation("OrdersDeletedByUser", fields: [deletedByUserId], references: [id], onDelete: SetNull)

  deleteReason String? @map("delete_reason")

  orderDate DateTime @default(now()) @map("order_date") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items          OrderItem[]
  stockMovements StockMovement[]
  batchAllocations OrderItemBatchAllocation[]

  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@index([deliveryStatus])
  @@index([customerId])
  @@index([createdByUserId])
  @@index([orderDate])
  @@index([createdAt])
  @@index([deletedAt])

  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid()) @db.Uuid

  orderId String @map("order_id") @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  productName String  @map("product_name")
  sku         String?

  kgPerBag Decimal @map("kg_per_bag") @db.Decimal(10, 2)

  quantityBags Decimal @map("quantity_bags") @db.Decimal(12, 2)
  quantityKg   Decimal @map("quantity_kg") @db.Decimal(12, 2)

  pricePerKg Decimal @map("price_per_kg") @db.Decimal(12, 2)

  lineTotal Decimal @default(0) @map("line_total") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  batchAllocations OrderItemBatchAllocation[]

  @@index([orderId])
  @@index([productId])

  @@map("order_items")
}

model StockMovement {
  id String @id @default(uuid()) @db.Uuid

  productId String  @map("product_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  orderId String? @map("order_id") @db.Uuid
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  importShipmentId String? @map("import_shipment_id")
  importShipment   ImportShipment? @relation(fields: [importShipmentId], references: [id], onDelete: Restrict)

  stockBatchId String? @map("stock_batch_id")
  stockBatch   StockBatch? @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  movementType StockMovementType @map("movement_type")

  quantityBags Decimal @map("quantity_bags") @db.Decimal(12, 2)
  quantityKg   Decimal @map("quantity_kg") @db.Decimal(12, 2)

  createdByUserId String @map("created_by_user_id") @db.Uuid
  createdByUser   User   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)

  reason String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([productId])
  @@index([orderId])
  @@index([importShipmentId])
  @@index([stockBatchId])
  @@index([movementType])
  @@index([createdByUserId])
  @@index([createdAt])

  @@map("stock_movements")
}

model Expense {
  id String @id @default(cuid())

  title         String
  category      ExpenseCategory
  amount        Decimal              @db.Decimal(12, 2)
  expenseDate   DateTime             @map("expense_date")
  paymentMethod ExpensePaymentMethod @map("payment_method")
  notes         String?
  status        ExpenseStatus        @default(ACTIVE)

  createdByUserId String?        @map("created_by_user_id") @db.Uuid
  createdByRole   CreatedByRole? @map("created_by_role")

  deletedAt       DateTime? @map("deleted_at")
  deletedByUserId String?   @map("deleted_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([paymentMethod])
  @@index([expenseDate])
  @@index([status])
  @@index([deletedAt])
  @@map("expenses")
}

model IdSequence {
  id String @id @default(uuid()) @db.Uuid

  key          IdSequenceKey @unique
  currentValue Int          @default(0) @map("current_value")

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("id_sequences")
}

model ImportShipment {
  id String @id @default(cuid())

  importNo   String   @unique @map("import_no")
  importDate DateTime @map("import_date") @db.Timestamptz(6)

  supplierName String? @map("supplier_name")
  referenceNo  String? @map("reference_no")
  containerNo  String? @map("container_no")
  notes        String?

  status ImportStatus @default(DRAFT)

  totalKg   Decimal @default(0) @db.Decimal(14, 2) @map("total_kg")
  totalBags Decimal @default(0) @db.Decimal(14, 2) @map("total_bags")

  totalAmountPaidUsd       Decimal @default(0) @db.Decimal(14, 2) @map("total_amount_paid_usd")
  totalUsdConvertedLkr     Decimal @default(0) @db.Decimal(14, 2) @map("total_usd_converted_lkr")
  totalUndiyalPaidLkr      Decimal @default(0) @db.Decimal(14, 2) @map("total_undiyal_paid_lkr")
  totalDutyTaxLkr          Decimal @default(0) @db.Decimal(14, 2) @map("total_duty_tax_lkr")
  totalClearingChargesLkr  Decimal @default(0) @db.Decimal(14, 2) @map("total_clearing_charges_lkr")
  totalMiscellaneousLkr    Decimal @default(0) @db.Decimal(14, 2) @map("total_miscellaneous_lkr")
  totalShipmentCostLkr     Decimal @default(0) @db.Decimal(14, 2) @map("total_shipment_cost_lkr")
  totalExpectedRevenueLkr  Decimal @default(0) @db.Decimal(14, 2) @map("total_expected_revenue_lkr")
  totalExpectedProfitLkr   Decimal @default(0) @db.Decimal(14, 2) @map("total_expected_profit_lkr")
  expectedProfitMarginPercentage Decimal @default(0) @db.Decimal(8, 2) @map("expected_profit_margin_percentage")

  createdByUserId String?        @map("created_by_user_id") @db.Uuid
  createdByRole   CreatedByRole? @map("created_by_role")

  confirmedAt       DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedByUserId String?   @map("confirmed_by_user_id") @db.Uuid
  cancelledAt       DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId String?   @map("cancelled_by_user_id") @db.Uuid
  reversedAt        DateTime? @map("reversed_at") @db.Timestamptz(6)
  reversedByUserId  String?   @map("reversed_by_user_id") @db.Uuid
  reverseReason     String?   @map("reverse_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items          ImportItem[]
  stockBatches   StockBatch[]
  stockMovements StockMovement[]

  @@index([status, importDate])
  @@index([supplierName])
  @@map("import_shipments")
}

model ImportItem {
  id String @id @default(cuid())

  importShipmentId String @map("import_shipment_id")
  productId        String @map("product_id") @db.Uuid

  quantityKg   Decimal @db.Decimal(14, 2) @map("quantity_kg")
  kgPerBag     Decimal @db.Decimal(10, 2) @map("kg_per_bag")
  quantityBags Decimal @db.Decimal(14, 2) @map("quantity_bags")

  usdAmountPerKg     Decimal @default(0) @db.Decimal(14, 4) @map("usd_amount_per_kg")
  amountPaidUsd      Decimal @default(0) @db.Decimal(14, 2) @map("amount_paid_usd")
  exchangeRateLkrUsd Decimal @default(0) @db.Decimal(14, 4) @map("exchange_rate_lkr_usd")
  usdConvertedLkr    Decimal @default(0) @db.Decimal(14, 2) @map("usd_converted_lkr")

  undiyalPaidLkr     Decimal @default(0) @db.Decimal(14, 2) @map("undiyal_paid_lkr")
  dutyTaxLkr         Decimal @default(0) @db.Decimal(14, 2) @map("duty_tax_lkr")
  clearingChargesLkr Decimal @default(0) @db.Decimal(14, 2) @map("clearing_charges_lkr")
  miscellaneousLkr   Decimal @default(0) @db.Decimal(14, 2) @map("miscellaneous_lkr")

  finalItemCostLkr Decimal @default(0) @db.Decimal(14, 2) @map("final_item_cost_lkr")
  costPerKgLkr     Decimal @default(0) @db.Decimal(14, 4) @map("cost_per_kg_lkr")
  costPerBagLkr    Decimal @default(0) @db.Decimal(14, 2) @map("cost_per_bag_lkr")

  sellingPricePerKgLkr          Decimal @default(0) @db.Decimal(14, 2) @map("selling_price_per_kg_lkr")
  expectedRevenueLkr            Decimal @default(0) @db.Decimal(14, 2) @map("expected_revenue_lkr")
  expectedProfitLkr             Decimal @default(0) @db.Decimal(14, 2) @map("expected_profit_lkr")
  expectedProfitMarginPercentage Decimal @default(0) @db.Decimal(8, 2) @map("expected_profit_margin_percentage")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  importShipment ImportShipment @relation(fields: [importShipmentId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  stockBatch     StockBatch?

  @@index([importShipmentId])
  @@index([productId])
  @@map("import_items")
}

model StockBatch {
  id String @id @default(cuid())

  productId        String @map("product_id") @db.Uuid
  importShipmentId String @map("import_shipment_id")
  importItemId     String @unique @map("import_item_id")
  batchNo          String @unique @map("batch_no")
  importDate       DateTime @map("import_date") @db.Timestamptz(6)

  initialKg    Decimal @db.Decimal(14, 2) @map("initial_kg")
  initialBags  Decimal @db.Decimal(14, 2) @map("initial_bags")
  remainingKg  Decimal @db.Decimal(14, 2) @map("remaining_kg")
  remainingBags Decimal @db.Decimal(14, 2) @map("remaining_bags")
  kgPerBag     Decimal @db.Decimal(10, 2) @map("kg_per_bag")
  costPerKgLkr Decimal @db.Decimal(14, 4) @map("cost_per_kg_lkr")
  costPerBagLkr Decimal @db.Decimal(14, 2) @map("cost_per_bag_lkr")
  status StockBatchStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  importShipment ImportShipment @relation(fields: [importShipmentId], references: [id], onDelete: Restrict)
  importItem     ImportItem     @relation(fields: [importItemId], references: [id], onDelete: Restrict)
  allocations    OrderItemBatchAllocation[]
  stockMovements StockMovement[]

  @@index([productId, status, importDate])
  @@index([importShipmentId])
  @@map("stock_batches")
}

model OrderItemBatchAllocation {
  id String @id @default(cuid())

  orderId      String @map("order_id") @db.Uuid
  orderItemId  String @map("order_item_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  stockBatchId String @map("stock_batch_id")

  quantityKg   Decimal @db.Decimal(14, 2) @map("quantity_kg")
  quantityBags Decimal @db.Decimal(14, 2) @map("quantity_bags")
  costPerKgLkr Decimal @db.Decimal(14, 4) @map("cost_per_kg_lkr")
  totalCostLkr Decimal @db.Decimal(14, 2) @map("total_cost_lkr")
  restoredAt   DateTime? @map("restored_at") @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  stockBatch StockBatch @relation(fields: [stockBatchId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([stockBatchId])
  @@map("order_item_batch_allocations")
}
